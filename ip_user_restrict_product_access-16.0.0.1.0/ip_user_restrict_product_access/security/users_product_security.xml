<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_product_restriction_manager" model="res.groups">
            <field name="name">Product Restriction Manager </field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <data noupdate="1">

        <record id="filter_allowed_product_tmpl_to_user" model="ir.rule">
            <field name="name">Allowed Product to Users</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('id', 'in', [product_id.product_tmpl_id.id for product_id in user.product_ids]), ('categ_id', 'in', [categ_id.id for categ_id in user.categ_ids])]</field>
        </record>

        <record id="filter_allowed_product_tmpl_to_admin" model="ir.rule">
            <field name="name">Allowed Product to Admin</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('ip_user_restrict_product_access.group_product_restriction_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="filter_allowed_product_to_user" model="ir.rule">
            <field name="name">Allowed Product to Users</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('id', 'in', [product_id.id for product_id in user.product_ids]), ('categ_id', 'in', [categ_id.id for categ_id in user.categ_ids])]</field>
        </record>

        <record id="filter_allowed_product_to_admin" model="ir.rule">
            <field name="name">Allowed Product to Admin</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="groups" eval="[(4, ref('ip_user_restrict_product_access.group_product_restriction_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>    

	<record id="so_line_multi_warehouse_view" model="ir.ui.view">
			<field name="name">sale order</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form"/>
			<field name="arch" type="xml">
				<xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
					<button name="%(sale_order_line_multi_warhouse_app.action_view_sale_multi_warehouse)d"
					type="action" icon="fa-list-ul" class="text-info" 
					groups="sale_order_line_multi_warhouse_app.group_show_sale_order_product_details"/>

				</xpath>

				<div name="button_box" position="inside">
					<button type="object" class="oe_stat_button" icon="fa-truck" name="action_delivery"
						attrs="{'invisible': [('delivery_count', '=', 0)]}">
						<field string="Delivery" name="delivery_count" widget="statinfo"/>
					</button>
				</div>
				
				<xpath expr="//field[@name='order_line']" position="after">
					<group string="Warehouse Informations" invisible="1">
						<field name="custom_warehouse_line" nolabel='1' invisible="1">
							<tree editable="bottom">
								<field name="product_id"/>
								<field name="so_warehouse_id"/>
								<field name="so_product_uom"/>
								<field name="quantity"/>
							</tree>
						</field>
					</group>
				</xpath>
			   
			</field>
	</record>

	<record id="view_order_form_inherit_sale_stock" model="ir.ui.view">
		<field name="name">sale.order.form.sale.stock</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
		<field name="arch" type="xml">
			<xpath expr="//button[@name='action_view_delivery']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
		</field>
	</record>
</odoo>
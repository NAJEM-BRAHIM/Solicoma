<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="show_sale_order_product_multi_warehouse" model="ir.ui.view">
        <field name="name">sale.multi.warehouse.form</field>
        <field name="model">sale.multi.warehouse</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="product_qty" readonly="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Warehouse Lines">
                        <field name="so_warehouse_line" nolabel="1">
                            <tree editable="bottom">
                                <field name="warehouse_id" readonly="1"/>
                                <field name="pro_warehouse_id" invisible="1"/>
                                <field name="product_uom" readonly="1"/>
                                <field name="pro_uom" invisible="1"/>
                                <field name="available_qty"/>
                                <field name="custom_quantity"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm_details" string="Save &amp; Close"
                        type="object" class="oe_highlight" />
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_sale_multi_warehouse" model="ir.actions.act_window">
        <field name="name">Product Multi-Warehouse Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.multi.warehouse</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
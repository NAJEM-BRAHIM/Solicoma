<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campo Cajas en líneas de pedido de venta -->
    <record id="sale_order_virtualbox_form" model="ir.ui.view">
        <field name="name">sale.order.virtualbox.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Columna Cajas en la lista de líneas -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="virtual_box" string="Cajas" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

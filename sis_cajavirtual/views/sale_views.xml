<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="sale_order_virtualbox_form" model="ir.ui.view">
		<field name="name">sale.order.virtualbox.form</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="arch" type="xml">            			
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/tree/field[@name='product_uom']" position="after">
				<field name='virtual_box' optional="show"/>
            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/form/group/group/field[@name='product_uom_readonly']" position="after">
				<field name='virtual_box' optional="show"/>
            </xpath>            
		</field>
	</record>
</odoo>

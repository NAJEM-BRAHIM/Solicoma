<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columna Cajas en la lista de productos (Inventario → Productos) -->
    <record id="product_product_stock_virtualbox" model="ir.ui.view">
        <field name="name">product.product.stock.virtualbox</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <field name="virtual_box" string="Cajas" optional="show" sum="Total Cajas"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_report_picking_inherit_sis_cajavirtual" inherit_id="stock.report_picking">
        <xpath expr="//table/thead/tr" position="inside">
            <th name="th_sm_boxes"><strong>Cajas</strong></th>
        </xpath>
        <xpath expr="//table/tbody//tr" position="inside">
            <td>
                <span t-field="ml.virtual_box"/>
            </td>
        </xpath>
    </template>

    <template id="report_delivery_document_inherit_sis_cajavirtual" inherit_id="stock.report_delivery_document">
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="after">            
            <th name="th_sm_boxes"><strong>Cajas</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="after">
            <td>
                <span t-field="move.virtual_box"/>
            </td>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="after">
            <th name="th_sml_boxes" class="text-center"><strong>Cajas</strong></th>
        </xpath>

        <xpath expr="//table[@name='stock_backorder_table']/thead/tr/th[@name='th_sb_quantity']" position="after">
            <th name="th_sb_boxes" class="text-center"><strong>Cajas</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_backorder_table']/tbody/t/tr/td[3]" position="after">
            <td>
                <span t-field="bo_line.virtual_box"/>
            </td>
        </xpath>        
    </template>

    <template id="stock_report_delivery_aggregated_move_lines_inherit_sis_cajavirtual" inherit_id="stock.stock_report_delivery_aggregated_move_lines"> 
        <xpath expr="//tr/td[3]" position="after">
            <td>
                <span t-esc="aggregated_lines[line]['virtual_box']" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
            </td>
        </xpath>     
    </template>

    <template id="stock_report_delivery_has_serial_move_line_inherit_sis_cajavirtual" inherit_id="stock.stock_report_delivery_has_serial_move_line"> 
        <xpath expr="//td[@name='move_line_lot_qty_done']" position="after">
            <td>
                <span t-field="move_line.move_id.virtual_box"/>
            </td>
        </xpath>     
    </template>    	   



    <template id="report_inventory_sis_cajavirtual" inherit_id="stock.report_inventory">
        <xpath expr="//table/thead/tr/th[4]" position="after">            
            <th name="th_sm_boxes"><strong>Cajas</strong></th>
        </xpath>
        <xpath expr="//table/tbody/t/tr[2]/td[4]" position="after">
            <td>
                <span t-field="line.virtual_box"/>
            </td>
        </xpath>        
    </template>

    <template id="report_package_barcode_sis_cajavirtual" inherit_id="stock.report_package_barcode">
        <xpath expr="//table[2]/thead/tr/th[@name='th_uom']" position="after">
          <th name="th_box" class="text-right">Cajas</th>
        </xpath>
        <xpath expr="//table[2]/tbody/tr/td[3]" position="after">
          <td class="text-right">
              <span t-field="l.virtual_box"/>
          </td>
        </xpath>
        <xpath expr="//table[2]/tbody/tr/td[1]/span" position="replace">
          <span t-field="l.product_id.display_name"/>
        </xpath>             
    </template>        

</odoo>
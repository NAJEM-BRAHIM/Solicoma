<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campo Cajas en albarán (movimientos) -->
    <record id="stock_picking_virtualbox_form" model="ir.ui.view">
        <field name="name">stock.picking.virtualbox.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']/field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="virtual_box" string="Cajas" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Campo Cajas en lista general de movimientos de stock -->
    <record id="view_move_line_virtualbox_tree" model="ir.ui.view">
        <field name="name">stock.move.line.virtualbox.list</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="virtual_box" string="Cajas" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Campo Cajas en Operación Detallada (popup detalle de operaciones) -->
    <record id="stock_move_line_virtualbox_detailed" model="ir.ui.view">
        <field name="name">stock.move.line.virtualbox.detailed</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="virtual_box" string="Cajas" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Campo Cajas en lista de operaciones del albarán -->
    <record id="view_stock_move_line_operation_tree_virtualbox" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.virtualbox</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="virtual_box" string="Cajas"/>
            </xpath>
        </field>
    </record>

    <!-- Campo Cajas en inventario editable (Ubicaciones) -->
    <record id="stock_quant_virtualbox_tree" model="ir.ui.view">
        <field name="name">stock.quant.virtualbox.tree</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity_auto_apply']" position="after">
                <field name="virtual_box" string="Cajas" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Campo Cajas en inventario (Ajuste de inventario) -->
    <record id="view_stock_quant_virtual_box_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.virtualbox.inventory.editable</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_quantity']" position="after">
                <field name="virtual_box" string="Cajas" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

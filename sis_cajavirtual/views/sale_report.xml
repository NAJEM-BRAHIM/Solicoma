<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_inherit_sis_cajavirtual" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table/thead/tr/th[@name='th_quantity']" position="after">
            <th name="th_boxes" class="text-end">Boxes</th>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_quantity']" position="after">
            <td name="td_boxes" class="text-end">
                <span t-field="line.virtual_box"/>
            </td>
        </xpath> 
        <xpath expr="//t[@t-foreach='lines_to_report']" position="after">
           <tr>
                <td colspan="1" class="text-right">
                </td>
                <td class="text-end">
                    <span t-out="sum(lines_to_report.mapped('product_uom_qty'))"/> <span t-field="line.product_uom_id">units</span>
                </td>
                <td class="text-end">
                    <span t-out="sum(lines_to_report.mapped('virtual_box'))"/>
                </td>
                <td colspan="5"></td>
           </tr>
        </xpath>
    </template>
</odoo>
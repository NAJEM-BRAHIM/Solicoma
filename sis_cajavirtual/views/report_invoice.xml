<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_inherit_sis_cajavirtual" inherit_id="account.report_invoice_document">
        <xpath expr="//table/thead/tr/th[@name='th_quantity']" position="after">
            <th name="th_sm_boxes"><strong>Cajas</strong></th>
        </xpath>
        <xpath expr="//table/tbody/t/tr/t/td[2]" position="after">
            <td class="text-end">
                <span t-field="line.virtual_box"/>
            </td>
        </xpath>

        <xpath expr="//table[@name='invoice_line_table']" position="inside">
            <tbody class="invoice_tbody1">
                <tr>
                    <td colspan="1"></td>
                    <td class="text-end">
                        <strong t-esc="sum([l.quantity for l in lines])" t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                    </td>
                    <td class="text-end">
                        <strong t-esc="sum([l.virtual_box for l in lines])"/>
                    </td>
                </tr>
            </tbody>
        </xpath>
    </template>
</odoo>
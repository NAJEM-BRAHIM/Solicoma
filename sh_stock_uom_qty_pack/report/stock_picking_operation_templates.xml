<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="sh_report_stock_picking_operation_document_custom" inherit_id="stock.report_picking">
        <xpath expr="//table[1]/thead/tr[1]/th[2]" position="before">
            <th name="th_bag_qty">
                <strong>Bag Quantity</strong>
            </th>
        </xpath>
        <xpath expr="//table[1]//tbody//tr[1]//td[2]" position="before">
            <td>
                <span t-out="o.move_ids_without_package.sh_qty_in_bag" />
            </td>
        </xpath>

        <xpath expr="//table[1]/thead/tr[1]/th[1]" position="after">
            <th t-if="o.sh_enable_quantity_in_report==True" name="th_qty_in_bag">
                <strong>Quantity in Bag</strong>
            </th>
        </xpath>

        <xpath expr="//table[1]//tbody//tr[1]//td[1]" position="after">
            <td t-if="o.sh_enable_quantity_in_report==True">
                <span t-field="o.move_ids_without_package.sh_qty_in_bag" />
            </td>
        </xpath>

    </template>
</odoo>
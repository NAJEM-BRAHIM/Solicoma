<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botón "Usa Cajas Virtuales" en zona de opciones del producto -->
    <record id="view_product_form_virtual_boxes" model="ir.ui.view">
        <field name="name">product.template.form.virtual_boxes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span name="virtual_box_option" class="d-inline-flex gap-2">
                    <field name="use_virtual_box"/>
                    <label for="use_virtual_box"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>

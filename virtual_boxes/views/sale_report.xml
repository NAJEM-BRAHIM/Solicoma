<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_inherit_sis_cajavirtual" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table/thead/tr/th[@name='th_quantity']" position="after">
            <th name="th_boxes" class="text-end">Cajas</th>
        </xpath>
        <xpath expr="//tr[@name='tr_product']/td[@name='td_product_quantity']" position="after">
            <td name="td_boxes" class="text-end">
                <span t-field="line.virtual_box"/>
            </td>
        </xpath>
        <!-- Totales de Kg y Cajas alineados debajo de columnas -->
        <xpath expr="//div[@name='so_total_summary']" position="before">
            <div class="row mb-2">
                <div class="col-12">
                    <table class="table table-sm mb-0" style="border-top: 2px solid #dee2e6;">
                        <tbody>
                            <tr>
                                <td style="width:50%;"></td>
                                <td class="text-end fw-bold" style="width:15%;">
                                    <span t-esc="sum(line.product_uom_qty for line in doc.order_line if line.display_type not in ('line_section', 'line_note'))"/>
                                </td>
                                <td class="text-end fw-bold" style="width:10%;">
                                    <span t-esc="sum(line.virtual_box for line in doc.order_line if line.display_type not in ('line_section', 'line_note'))"/>
                                </td>
                                <td style="width:25%;"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

</odoo>

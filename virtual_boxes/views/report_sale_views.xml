<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Añade columna "Nº Cajas" en el informe de pedido de venta.
        Este template hereda report_saleorder_document, que es utilizado tanto
        por el pedido de venta como por la factura pro forma.
    -->
    <template id="report_saleorder_virtual_boxes" inherit_id="sale.report_saleorder_document">
        <!-- Cabecera de la tabla -->
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_boxes" class="text-end text-nowrap">Nº Cajas</th>
        </xpath>
        <!-- Celda de datos por línea -->
        <xpath expr="//td[@name='td_product_quantity']" position="after">
            <td name="td_product_boxes" class="text-end">
                <span t-if="line.num_boxes" t-out="line.num_boxes"/>
            </td>
        </xpath>
        <!-- Totales alineados bajo sus columnas (Descripción / Cantidad / Nº Cajas / resto) -->
        <xpath expr="//tbody[hasclass('sale_tbody')]" position="inside">
            <t t-set="vb_lines" t-value="doc.order_line.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))"/>
            <t t-set="vb_total_qty" t-value="sum(vb_lines.mapped('product_uom_qty'))"/>
            <t t-set="vb_total_boxes" t-value="sum(vb_lines.mapped('num_boxes'))"/>
            <tr style="border-top: 2px solid #dee2e6;" class="fw-bold">
                <td>Total</td>
                <td class="text-end"><span t-out="'%.2f' % vb_total_qty"/></td>
                <td class="text-end"><span t-out="vb_total_boxes"/></td>
                <td colspan="10"/>
            </tr>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_code_price" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.inventory.valuation.with.cost</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']/field[@name='move_ids']/list/field[@name='product_uom_qty']"
                   position="before">
                <field name="price_unit" string="Cost" column_invisible ="parent.picking_type_code !=  'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>

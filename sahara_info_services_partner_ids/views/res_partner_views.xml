<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_partner_ids" model="ir.ui.view">
        <field name="name">res.partner.form.partner.ids</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_ma_ice" placeholder="ICE (15 chiffres)"/>
                <field name="l10n_ma_nif" placeholder="NIF"/>
                <field name="l10n_ma_rc" placeholder="RC"/>
            </xpath>
        </field>
    </record>
</odoo>

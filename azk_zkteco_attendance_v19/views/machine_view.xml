<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_yzk_machine_form" model="ir.ui.view">
        <field name="name">azk.machine.form</field>
        <field name="model">azk.machine</field>
        <field name="arch" type="xml">
            <form string="Biometric Device">
                <header>
                    <!-- v19: icon attribute removed from buttons (use CSS classes instead) -->
                    <button name="clear_attendance" type="object"
                            string="Clear Device Data" class="btn-danger"
                            confirm="Are you sure you want to clean the device? Make sure all data is downloaded to Odoo first"/>
                    <button name="download_attendance" type="object"
                            string="Download Attendance" class="btn-primary"/>
                    <button name="test_connection" type="object"
                            string="Test Connection" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Machine Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="machine_ip"
                                   help="IP of the device to connect to. Make sure it is accessible by Odoo. If the device is on premises and Odoo is on the cloud, install a tunnel like ngrok or expose the machine IP."/>
                            <field name="port_num"/>
                            <field name="password" password="True"/>
                            <field name="auto_create_employee"/>
                            <field name="timeout"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="address_id" string="Location"
                                   help="Working address / location for this machine."/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <group>
                                <field name="serial_num" readonly="1"/>
                            </group>
                            <group>
                                <field name="last_run_status" readonly="True" widget="toggle_button"/>
                                <field name="last_error_msg" readonly="True"/>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page name="lunch" string="Auto Deduction">
                            <group>
                                <field name="lunch_auto_deduction"/>
                                <field name="lunch_deduction_hours"
                                       invisible="not lunch_auto_deduction"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- v19: <tree> renamed to <list> -->
    <record id="view_azk_machine_list" model="ir.ui.view">
        <field name="name">azk.machine.list</field>
        <field name="model">azk.machine</field>
        <field name="arch" type="xml">
            <list string="Biometric Machine">
                <field name="name"/>
                <field name="machine_ip"/>
                <field name="port_num"/>
                <field name="timeout"/>
                <field name="serial_num" readonly="True"/>
                <field name="last_run_status" readonly="True" widget="toggle_button"/>
                <field name="last_error_msg" readonly="True"/>
                <field name="address_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="azk_machine_action" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">azk.machine</field>
        <!-- v19: view_mode uses 'list' instead of 'tree' -->
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_employee_inherit_form_view" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="device_id"/>
            </xpath>
        </field>
    </record>

    <menuitem id="azk_machine_menu"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="50"
              name="Attendance Machine"/>
    <menuitem id="azk_machine_sub_menu"
              parent="azk_machine_menu"
              name="Machine Configuration"
              action="azk_machine_action"
              sequence="1"/>

    <record id="action_delete_machine_user" model="ir.actions.server">
        <field name="name">Delete User On Machine</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_delete_machine_users()
        </field>
    </record>

    <record id="action_create_machine_user" model="ir.actions.server">
        <field name="name">Create User On Machine</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <!-- v19: binding_view_types uses 'list' instead of 'tree' -->
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_create_machine_users()
        </field>
    </record>

</odoo>

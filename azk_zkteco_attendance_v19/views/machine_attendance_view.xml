<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customize Attendance Report: add worked_hours as measure -->
    <record id="inherited_view_attendance_list" model="ir.ui.view">
        <field name="name">inherited_hr.attendance.list</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <!-- v19: <tree> inside xpath → <list>; 'type="measure"' still valid for optional/measure cols -->
            <xpath expr="//list" position="inside">
                <field name="worked_hours" type="measure"/>
            </xpath>
        </field>
    </record>

    <record id="inherited_hr_attendance_view_filter" model="ir.ui.view">
        <field name="name">inherited_hr_attendance_view_filter</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='groupby_name']" position="after">
                <filter name="date" string="Date" context="{'group_by': 'check_in:day'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_azk_report_daily_attendance_search" model="ir.ui.view">
        <field name="name">azk.report.daily.attendance.search</field>
        <field name="model">azk.report.daily.attendance</field>
        <field name="arch" type="xml">
            <search string="Attendance Search">
                <!-- v19: 'icon' attribute on <filter> is deprecated/removed -->
                <filter string="My Attendance" name="my_attendance"
                        domain="[('name.user_id.id', '=', uid)]"/>
                <filter name="today" string="Today"
                        domain="[('check_in', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d'))]"/>
                <filter string="Current Month" name="month"
                        domain="[('check_in', '&gt;=', datetime.datetime.now().strftime('%Y-%m-01'))]"/>
                <separator/>
                <field name="name" string="Name"/>
                <group name="Attendance group by">
                    <filter name="Employee"     string="Employee"      context="{'group_by': 'name'}"/>
                    <filter name="Date"         string="Date"          context="{'group_by': 'punching_day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- v19: <tree> → <list> -->
    <record id="view_azk_report_daily_attendance_list" model="ir.ui.view">
        <field name="name">azk.report.daily.attendance.list</field>
        <field name="model">azk.report.daily.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false" delete="false" default_order="punching_day desc">
                <field name="punching_day"/>
                <field name="name"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" sum="Total"/>
                <field name="address_id"/>
            </list>
        </field>
    </record>

    <record id="action_azk_report_daily_attendance" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">azk.report.daily.attendance</field>
        <!-- v19: 'tree' → 'list' -->
        <field name="view_mode">list</field>
        <field name="context">{'search_default_my_attendance': 1}</field>
        <field name="search_view_id" ref="view_azk_report_daily_attendance_search"/>
    </record>

    <menuitem id="menu_azk_attendance_view"
              name="Attendance Log"
              action="action_azk_report_daily_attendance"
              parent="azk_machine_menu"
              sequence="2"
              groups="hr_attendance.group_hr_attendance_officer"/>
</odoo>
